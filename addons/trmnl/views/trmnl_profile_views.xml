<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="trmnl_profile_view_list" model="ir.ui.view">
        <field name="name">trmnl.profile.list</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <list string="TRMNL Profiles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="device_id"/>
                <field name="app_module_id"/>
                <field name="app_model_id"/>
                <field name="trmnl_layout"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="trmnl_profile_view_form" model="ir.ui.view">
        <field name="name">trmnl.profile.form</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <form string="TRMNL Profile">
                <header>
                    <button
                        name="action_render_preview"
                        string="Render Preview"
                        type="object"
                        class="btn-primary"
                        invisible="not odoo_action_id"
                    />
                    <button
                        name="action_set_fast_refresh"
                        string="Set Fast Refresh (60s)"
                        type="object"
                    />
                    <button
                        name="action_restore_refresh"
                        string="Restore 30 min Refresh"
                        type="object"
                    />
                </header>

                <sheet>
                    <!-- ── Identity ──────────────────────────────────── -->
                    <group>
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="active"/>
                    </group>

                    <!-- ── Odoo Source ───────────────────────────────── -->
                    <!-- odoo_action_id is hidden once app_model_id is   -->
                    <!-- resolved (known app auto-selected); shown for   -->
                    <!-- unknown apps where the user must pick manually. -->
                    <group string="Odoo Source">
                        <field name="app_module_id"/>
                        <field
                            name="project_display_mode"
                            invisible="app_module_id.name != 'project'"
                        />
                        <field
                            name="todo_display_mode"
                            invisible="app_module_id.name != 'project_todo'"
                        />
                        <field
                            name="crm_display_mode"
                            invisible="app_module_id.name != 'crm'"
                        />
                        <field
                            name="pos_display_mode"
                            invisible="app_module_id.name != 'point_of_sale'"
                        />
                        <field
                            name="odoo_action_id"
                            invisible="app_model_id"
                            help="Auto-selected for known apps. Select manually for others."
                        />
                        <field
                            name="trmnl_layout"
                            invisible="not app_model_id"
                        />
                        <field name="app_model_id" readonly="1"/>
                    </group>

                    <!-- ── Display Fields (list/table layouts only) ─── -->
                    <group
                        string="Display Fields"
                        invisible="not app_model_id or trmnl_layout == 'calendar'"
                    >
                        <field
                            name="display_field_ids"
                            domain="[('model_id', '=', app_model_id), ('ttype', 'not in', ['binary', 'html', 'one2many', 'many2many', 'serialized', 'reference'])]"
                            widget="many2many_tags"
                            nolabel="1"
                        />
                    </group>

                    <!-- ── Display Settings (list/table layouts only) ── -->
                    <group
                        string="Display Settings"
                        invisible="not odoo_action_id or trmnl_layout == 'calendar'"
                    >
                        <field name="filter_preset"/>
                        <field name="sort_preset"/>
                        <field name="display_limit"/>
                        <field
                            name="display_order"
                            placeholder="e.g. date desc, name asc"
                            help="Advanced: manual ORDER BY clause. Ignored when Sort is not Default."
                        />
                    </group>

                    <!-- ── Calendar Settings (calendar layout only) ─── -->
                    <group string="Calendar Settings" invisible="trmnl_layout != 'calendar'">
                        <field name="calendar_view_mode"/>
                        <field name="calendar_week_mode"
                               invisible="calendar_view_mode != 'week'"/>
                        <field name="calendar_reference_mode"/>
                        <field
                            name="calendar_reference_date"
                            invisible="calendar_reference_mode != 'custom'"
                        />
                    </group>

                    <!-- ── Auto Refresh ─────────────────────────────── -->
                    <group string="Auto Refresh" invisible="not app_model_id">
                        <field name="auto_refresh_enabled"/>
                        <field
                            name="auto_refresh_interval_minutes"
                            invisible="not auto_refresh_enabled"
                        />
                    </group>

                    <!-- ── Preview ───────────────────────────────────── -->
                    <group string="Preview" invisible="not preview_image">
                        <field name="preview_generated_at" readonly="1"/>
                        <field
                            name="preview_image"
                            widget="image"
                            readonly="1"
                            nolabel="1"
                            colspan="2"
                        />
                    </group>

                    <!-- ── Device Delivery Status ─────────────────────── -->
                    <group string="Device Delivery Status">
                        <field name="device_last_polled_at" readonly="1"/>
                        <field name="device_next_expected_poll_at" readonly="1"/>
                        <field name="device_refresh_rate" readonly="1"/>
                        <field
                            name="display_image_url"
                            readonly="1"
                            widget="url"
                            invisible="not display_image_url"
                        />
                        <field
                            name="url_warning"
                            readonly="1"
                            invisible="not url_warning"
                            colspan="2"
                            nolabel="1"
                            style="color: #b45309; background: #fef3c7; padding: 8px; border-radius: 4px;"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="trmnl_profile_action_profiles" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">trmnl.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
