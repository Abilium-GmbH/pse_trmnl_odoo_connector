<odoo>
    <record id="view_trmnl_device_form" model="ir.ui.view">
        <field name="name">trmnl.device.form</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="webhook_url"/>
                        <field name="active"/>
                        <field name="last_sync_at"/>
                        <field name="last_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trmnl_device_list" model="ir.ui.view">
        <field name="name">trmnl.device.list</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="last_status"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="action_trmnl_devices" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">trmnl.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
