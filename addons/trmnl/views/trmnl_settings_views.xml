<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trmnl_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.trmnl</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="TRMNL" name="trmnl">
                    <block
                        title="Device policies"
                        help="Configure how the TRMNL backend handles device requests."
                    >
                        <setting
                            string="Unknown device policy"
                            help="Controls how the server reacts when a display poll arrives from an unknown MAC address or from a known device with an invalid token."
                        >
                            <field
                                name="trmnl_display_unknown_device_policy"
                                widget="radio"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
