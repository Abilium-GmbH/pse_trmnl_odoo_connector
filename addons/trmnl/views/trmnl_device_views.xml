<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         Server actions for the list-view Action drop-down
    ══════════════════════════════════════════════════ -->

    <record id="trmnl_device_action_bulk_accept" model="ir.actions.server">
        <field name="name">Accept Selected</field>
        <field name="model_id" ref="model_trmnl_device"/>
        <field name="binding_model_id" ref="model_trmnl_device"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_bulk_accept()</field>
    </record>

    <record id="trmnl_device_action_bulk_remove" model="ir.actions.server">
        <field name="name">Remove Selected</field>
        <field name="model_id" ref="model_trmnl_device"/>
        <field name="binding_model_id" ref="model_trmnl_device"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_bulk_remove()</field>
    </record>

    <record id="trmnl_device_action_bulk_reset" model="ir.actions.server">
        <field name="name">Reset Selected</field>
        <field name="model_id" ref="model_trmnl_device"/>
        <field name="binding_model_id" ref="model_trmnl_device"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_bulk_reset()</field>
    </record>

    <!-- ══════════════════════════════════════════════════
         Search view
    ══════════════════════════════════════════════════ -->

    <record id="trmnl_device_view_search" model="ir.ui.view">
        <field name="name">trmnl.device.view.search</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <search string="TRMNL Devices">
                <field name="device_name"/>
                <field name="mac_address"/>
                <field name="filename"/>
                <field name="approval_state"/>

                <filter
                    string="Accepted"
                    name="filter_accepted"
                    domain="[('approval_state','=','accepted')]"
                />

                <filter
                    string="Needs Attention"
                    name="filter_needs_attention"
                    domain="[('approval_state','in',['token_mismatch','unknown_device'])]"
                />

                <group>
                    <filter
                        string="Status"
                        name="group_approval_state"
                        context="{'group_by': 'approval_state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         List view
    ══════════════════════════════════════════════════ -->

    <record id="trmnl_device_view_list" model="ir.ui.view">
        <field name="name">trmnl.device.view.list</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <list
                string="Devices"
                create="false"
                edit="true"
                delete="true"
                default_order="sequence, id"
            >
                <field name="sequence" widget="handle" width="1"/>
                <field name="device_name" width="200"/>
                <field name="mac_address" width="100"/>

                <field name="approval_state" string="Status" widget="badge" width="100"
                    decoration-success="approval_state == 'accepted'"
                    decoration-warning="approval_state == 'token_mismatch'"
                    decoration-danger="approval_state == 'unknown_device'"
                />

                <field name="filename" width="100"/>
                <field name="last_seen_at" width="100"/>
                <field name="desired_refresh_rate_minutes" string="Refresh Rate (min)" width="100"/>
                <field name="battery_percentage"/>
                <field name="rssi_quality" string="Signal Strength" width="100"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         Form view
    ══════════════════════════════════════════════════ -->

    <record id="trmnl_device_view_form" model="ir.ui.view">
        <field name="name">trmnl.device.view.form</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <form string="TRMNL Device" create="false" delete="false">
                <header>
                    <button
                        name="action_open_accept_wizard"
                        string="Accept Device"
                        type="object"
                        class="btn-success"
                        invisible="not accept_button_visible"
                    />
                    <button
                        name="action_open_reset_wizard"
                        string="Reset Device"
                        type="object"
                        class="btn-warning"
                    />
                    <button
                        name="action_open_remove_wizard"
                        string="Remove Device"
                        type="object"
                        class="btn-danger"
                    />
                    <field
                        name="approval_state"
                        widget="statusbar"
                        statusbar_visible="unknown_device,token_mismatch,accepted"
                        readonly="1"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="device_name" class="oe_edit_only"/>
                        <h1>
                            <field name="device_name" placeholder="Enter a device name"/>
                        </h1>
                        <div class="text-muted">
                            <label for="mac_address" string="MAC Address:" class="oe_inline"/>
                            <field name="mac_address" readonly="1" class="oe_inline"/>
                        </div>
                    </div>

                    <field name="accept_button_visible" invisible="1"/>

                    <group>
                        <group string="Configuration">
                            <field name="image_url" readonly="1"/>

                            <label for="desired_refresh_rate_minutes" string="Refresh Rate"/>
                            <div class="o_field_widget">
                                <field name="desired_refresh_rate_minutes" class="oe_inline" style="width: 80px;"/>
                                <span class="oe_inline" style="margin-left: 4px;">minutes</span>
                            </div>

                            <field name="filename" readonly="1"/>
                        </group>

                        <group string="Telemetry">
                            <field name="battery_percentage" readonly="1"/>
                            <field name="rssi_quality" readonly="1" string="Signal Strength"/>
                            <field name="last_reported_refresh_rate_minutes" readonly="1" string="Last Reported Refresh Rate (min)"/>
                            <field name="added_at" readonly="1"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="last_api_call" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Logs">
                            <!-- Administrators can select and delete individual log entries
                                 using the standard list-view checkboxes and the Delete action.
                                 Log entries are also removed automatically when the device
                                 record itself is deleted. -->
                            <field name="log_ids">
                                <list create="false" edit="false" delete="true">
                                    <field name="log_id" width="1"/>
                                    <field name="name" width="300"/>
                                    <field name="created_at" width="100"/>
                                    <field name="wifi_status" width="100"/>
                                    <field name="refresh_rate" width="100"/>
                                    <field name="battery_voltage" width="100"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         Window action
    ══════════════════════════════════════════════════ -->

    <record id="trmnl_device_action_devices" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">trmnl.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="trmnl_device_view_search"/>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

</odoo>
