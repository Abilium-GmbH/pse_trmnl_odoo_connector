<odoo>
    <record id="view_trmnl_profile_form" model="ir.ui.view">
        <field name="name">trmnl.profile.form</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_send"
                            type="object"
                            string="Test Send"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="provider_type"/>
                        <field name="calendar_view_mode"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trmnl_profile_list" model="ir.ui.view">
        <field name="name">trmnl.profile.list</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_id"/>
                <field name="provider_type"/>
                <field name="calendar_view_mode"/>
            </list>
        </field>
    </record>

    <record id="action_trmnl_profiles" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">trmnl.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
