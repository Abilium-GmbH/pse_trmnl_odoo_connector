<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view -->
    <record id="view_trmnl_device_tree" model="ir.ui.view">
        <field name="name">trmnl.device.tree</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <list string="TRMNL Devices">
                <field name="name"/>
                <field name="device_id"/>
                <field name="webhook_url"/>
                <field name="active"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_trmnl_device_form" model="ir.ui.view">
        <field name="name">trmnl.device.form</field>
        <field name="model">trmnl.device</field>
        <field name="arch" type="xml">
            <form string="TRMNL Device">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="webhook_url"/>
                        <field name="active"/>
                        <field name="last_sync" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_trmnl_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">trmnl.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Top menu -->
    <menuitem id="menu_trmnl_root" name="TRMNL"/>

    <!-- Sub menu -->
    <menuitem
        id="menu_trmnl_device"
        name="Devices"
        parent="menu_trmnl_root"
        action="action_trmnl_device"/>
</odoo>