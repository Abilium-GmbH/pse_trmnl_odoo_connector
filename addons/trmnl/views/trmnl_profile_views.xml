<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="trmnl_profile_view_list" model="ir.ui.view">
        <field name="name">trmnl.profile.list</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <list string="TRMNL Profiles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="device_id"/>
                <field name="app_model_id" string="Odoo Model" optional="show"/>
                <field name="trmnl_layout" string="View Type" optional="show"/>
                <field name="auto_refresh_interval_minutes" string="Render Interval (min)" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="trmnl_profile_view_form" model="ir.ui.view">
        <field name="name">trmnl.profile.form</field>
        <field name="model">trmnl.profile</field>
        <field name="arch" type="xml">
            <form string="TRMNL Profile">
                <header>
                    <button
                        name="action_render_preview"
                        string="Render Preview"
                        type="object"
                        class="btn-primary"
                        invisible="not app_model_id"
                        help="Renders a new preview image and stores it in Odoo. The TRMNL device will download it automatically on its next poll."
                    />
                    <!-- URL warning near the render action so it is always visible -->
                    <field
                        name="url_warning"
                        readonly="1"
                        invisible="not url_warning"
                        nolabel="1"
                        style="color: #b45309; background: #fef3c7; padding: 4px 10px; border-radius: 4px; font-size: 12px;"
                    />
                </header>

                <sheet>

                    <!-- ── Identity ──────────────────────────────────── -->
                    <group string="Identity">
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="sequence" invisible="1"/>
                    </group>

                    <!-- ── Data Source ───────────────────────────────── -->
                    <group string="Data Source">
                        <field name="app_model_name" invisible="1"/>
                        <field name="available_view_types" invisible="1"/>

                        <field
                            name="app_model_id"
                            string="Odoo Model"
                            help="Select any installed Odoo model."
                        />
                        <field
                            name="trmnl_layout"
                            string="View Type"
                            widget="trmnl_layout_select"
                            invisible="not app_model_id"
                        />
                        <field
                            name="layout_warning"
                            invisible="not layout_warning"
                            widget="char"
                            readonly="1"
                            class="text-warning"
                        />
                    </group>

                    <!-- ── Calendar Settings ────────────────────────── -->
                    <group string="Calendar Settings" invisible="trmnl_layout != 'calendar'">
                        <field name="calendar_view_mode" string="Calendar View"/>
                        <field
                            name="calendar_week_mode"
                            string="Week Mode"
                            invisible="calendar_view_mode != 'week'"
                        />
                        <field name="calendar_reference_mode" string="Reference"/>
                        <field
                            name="calendar_reference_date"
                            string="Reference Date"
                            invisible="calendar_reference_mode != 'custom'"
                        />
                    </group>

                    <!-- ── Content ───────────────────────────────────── -->
                    <group string="Content" invisible="not app_model_id">
                        <field
                            name="display_field_ids"
                            string="Fields to Display"
                            domain="[
                                ('model_id', '=', app_model_id),
                                ('ttype', 'not in', ['binary', 'html', 'one2many', 'many2many', 'serialized', 'reference'])
                            ]"
                            widget="many2many_tags"
                            nolabel="1"
                            help="Choose which fields to show. Column order follows selection order."
                        />
                    </group>

                    <!-- ── Filters &amp; Sorting ──────────────────────── -->
                    <group string="Filters &amp; Sorting" invisible="not app_model_id">
                        <field name="filter_preset" string="Quick Filter"/>
                        <field
                            name="filter_domain"
                            string="Domain Filter"
                            widget="domain"
                            options='{"model": "app_model_name"}'
                            help='Extra filter applied on top of Quick Filter using AND.&#10;Example: [("user_id", "=", uid), ("stage_id.name", "!=", "Done")]&#10;Supports: uid, context_today(), True, False.'
                        />
                        <field
                            name="display_order"
                            string="Sort Order"
                            placeholder="e.g. date_deadline desc, name asc"
                            help="Raw ORDER BY clause passed to the Odoo search."
                        />
                        <field name="display_limit" string="Max Records"/>
                    </group>

                    <!-- ── Preview ───────────────────────────────────── -->
                    <group string="Preview" invisible="not preview_image">
                        <field name="preview_generated_at" readonly="1"/>
                        <field
                            name="preview_image"
                            widget="image"
                            readonly="1"
                            nolabel="1"
                            colspan="2"
                        />
                    </group>

                    <!-- ── Device Delivery Status ────────────────────── -->
                    <group
                        string="Device Delivery Status"
                        help="Device refresh rate is managed on the linked Device record under Devices → Refresh Rate."
                    >
                        <field name="device_last_polled_at" readonly="1" string="Device Last Polled"/>
                        <field name="device_next_expected_poll_at" readonly="1" string="Next Expected Poll"/>
                        <field name="device_refresh_rate" readonly="1" string="Device Refresh Rate"/>
                        <field
                            name="display_image_url"
                            readonly="1"
                            widget="url"
                            string="Image URL"
                            invisible="not display_image_url"
                        />
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="trmnl_profile_action_profiles" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">trmnl.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
